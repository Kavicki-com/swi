# Contrato de ambiente do app mobile (Expo).
#
# Copie para `.env` e ajuste. Só variáveis com o prefixo EXPO_PUBLIC_ chegam ao
# bundle, então NENHUMA delas pode conter segredo: tudo aqui é legível por quem
# tiver o APK ou o bundle web.
#
# Perfis de build de release declaram estes valores em `eas.json`, não neste
# arquivo. Este `.env` serve ao desenvolvimento local.

# URL base da API (NestJS). Obrigatória fora de desenvolvimento e teste.
# Em dev, se omitida, cai em http://localhost:3000.
# Emulador Android usa http://10.0.2.2:3000; device físico, o IP da LAN.
# Um endereço local é recusado em build de release.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Fonte de dados dos domínios NÃO-SAÚDE (perfil, relatórios, jornada, chat,
# notificações, clima, evacuação, posições). Valores aceitos: api | mock.
# Fora de dev e teste o valor é sempre `api`, salvo a escotilha de demonstração
# abaixo. Os vitais de saúde seguem simulados em todos os ambientes até a
# integração da smartband, e ignoram esta chave de propósito.
EXPO_PUBLIC_DATA_BACKEND=mock

# Fonte do login e cadastro. Valores aceitos: api | mock.
# Mesma regra: fora de dev e teste é sempre `api`.
EXPO_PUBLIC_AUTH_BACKEND=mock

# Escotilha de demonstração. Com o valor 1, dados simulados e URL local voltam a
# ser aceitos fora de dev, para apresentar o app sem backend no ar.
# NUNCA declare em perfil de release: o usuário final veria dados fabricados
# sem nenhuma sinalização. Deixe em 0 ou omita.
EXPO_PUBLIC_ALLOW_DEMO_MOCKS=0

# Origens HTTPS exatas, separadas por vírgula, de onde o app aceita abrir mídia
# (arquivos de exame). A origem da própria API já é aceita sem estar aqui; esta
# lista existe porque o arquivo é servido pelo storage, que tem endereço
# próprio. Origem exata, não sufixo: "https://api.kavicki.com.invasor.test" não
# entra por parecer com um domínio confiável.
#
# ATENÇÃO no perfil de release: sem a origem real do storage declarada aqui, o
# app RECUSA abrir exame e mostra "origem não autorizada". Para descobrir o
# valor, peça uma URL pré-assinada à API e use o esquema mais o host dela, sem
# caminho e sem query.
#
# O valor abaixo é o MinIO da stack local, não serve para release.
EXPO_PUBLIC_MEDIA_ORIGINS=http://localhost:9000
