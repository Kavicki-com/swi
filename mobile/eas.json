{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.23.2",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "autoIncrement": true
    },
    "development-simulator": {
      "node": "22.23.2",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "22.23.2",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_AUTH_BACKEND": "api",
        "EXPO_PUBLIC_DATA_BACKEND": "api",
        "EXPO_PUBLIC_API_URL": "https://api.kavicki.com"
      }
    },
    "qa": {
      "node": "22.23.2",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_AUTH_BACKEND": "api",
        "EXPO_PUBLIC_DATA_BACKEND": "api",
        "EXPO_PUBLIC_API_URL": "https://api.kavicki.com"
      },
      "autoIncrement": true
    },
    "qa-testflight": {
      "node": "22.23.2",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_AUTH_BACKEND": "api",
        "EXPO_PUBLIC_DATA_BACKEND": "api",
        "EXPO_PUBLIC_API_URL": "https://api.kavicki.com"
      }
    },
    "production": {
      "node": "22.23.2",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AUTH_BACKEND": "api",
        "EXPO_PUBLIC_DATA_BACKEND": "api",
        "EXPO_PUBLIC_API_URL": "https://api.kavicki.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6772364174"
      }
    },
    "qa-testflight": {
      "ios": {
        "ascAppId": "6772364174"
