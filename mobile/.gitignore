# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase do Android (push). Tem chave do projeto: fica fora do git. A build
# local usa uma cópia aqui; o EAS usa a variável de arquivo GOOGLE_SERVICES_JSON
# (ver app.config.js).
google-services.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Artefatos de inspeção na raiz do app (screenshots, dumps do Playwright MCP):
# ficam em disco, nunca no git. Espelha o mesmo par no .gitignore da raiz, que
# por ser ancorado com / só alcança a raiz do repo.
/*.png
/*.jpg
/*.jpeg
.playwright-mcp/

# Gerado pelo prebuild a partir de expo-target.config.js (icon); o EAS regenera
targets/watch/Assets.xcassets/
