dist/
storybook-static/
.vite/
coverage/
.env
.env.local
# Backups de env (.env.local.bak-tunnel e afins): o sufixo escapa dos padrões
# acima, e um deles já ficou rastreável por engano. Costumam ter credencial.
.env*.bak*
.DS_Store
*.log
*.tsbuildinfo
.tsbuild/
swi-admin/.tsbuild/

# Figma REST API dumps (contain internal node IDs / image refs)
docs/audits/figma-export/*.json

# Local debug artifacts at repo root (screenshots, scratch files, tooling output)
/*.png
/*.jpg
/*.jpeg
/.playwright-mcp/
/finalizar-bg.txt

# Local audit reports (kept on disk, not in git)
docs/audits/*-audit-*.md
docs/audits/health-check-*.md

# Build outputs (Android bundles/apks — built locally, never versioned)
*.aab
*.apk

# Orphan root lockfile (siblings each have their own; repo has no root package.json)
/package-lock.json

# Local Windows build/sync helpers (machine-specific paths: WSL distro, $HOME, Desktop)
*.bat

# Amplify Gen 2 generated / per-environment (swi-backend)
swi-backend/.amplify/
swi-backend/amplify_outputs*.json
swi-backend/node_modules/
mobile/amplify_outputs*.json
