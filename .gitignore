node_modules/
dist/
storybook-static/
.vite/
coverage/
.env
.env.local
# Backups de env (.env.local.bak-tunnel e afins): o sufixo escapa dos padrões
# acima, e um deles já ficou rastreável por engano. Costumam ter credencial.
.env*.bak*

# Configuração local do pacote de duplo clique. O START-SWI.cmd gera este
# arquivo na primeira execução com o segredo de assinatura JWT daquela máquina.
# O nome não termina em `.env`, então nenhum dos padrões acima o pegaria, e ele
# é credencial de verdade do stack local.
/swi-client.env
.DS_Store
*.log
*.tsbuildinfo
.tsbuild/
swi-admin/.tsbuild/

# Figma REST API dumps (contain internal node IDs / image refs)
docs/audits/figma-export/*.json

# Local debug artifacts at repo root (screenshots, scratch files, tooling output)
/*.png
/*.jpg
/*.jpeg
/.playwright-mcp/
/finalizar-bg.txt

# Local audit reports (kept on disk, not in git)
docs/audits/*-audit-*.md
docs/audits/health-check-*.md

# Build outputs (Android bundles/apks — built locally, never versioned)
*.aab
*.apk

# Orphan root lockfile (siblings each have their own; repo has no root package.json)
/package-lock.json

# Local Windows build/sync helpers (machine-specific paths: WSL distro, $HOME, Desktop)
*.bat

# Override de portas pra rodar o SWI ao lado do Ybá na mesma máquina.
# Decisão do usuário em 2026-07-30: fica local, é conveniência de dev e não
# contrato do projeto. Ignorado pra parar de aparecer como untracked.
swi-backend/docker-compose.ports-alt.yml

# Artefatos dos portões de qualidade e da entrega de código-fonte.
# Coverage, builds e relatórios de teste são reproduzíveis a partir do commit e
# nunca entram no repositório nem no pacote entregue ao cliente.
**/coverage/
**/dist/
**/test-results/
**/playwright-report/
.audit/
SWI-source-delivery-*/

# Amplify Gen 2 generated / per-environment (swi-backend)
swi-backend/.amplify/
swi-backend/amplify_outputs*.json
swi-backend/node_modules/
mobile/amplify_outputs*.json
