generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  // Handle visível (@username no chat e no perfil), fase 1 da função do campo
  // "Nome do usuário" do cadastro. Nullable: contas existentes não têm, e o
  // índice único do Postgres ignora NULL. A fase 2 (login por username) usa
  // esta mesma coluna.
  username       String?        @unique
  passwordHash   String
  name           String
  role           Role           @default(WORKER)
  emailVerified  Boolean        @default(false)
  approvalStatus ApprovalStatus @default(PENDING)
  active         Boolean        @default(true)

  confirmationCodeHash String?
  confirmationExpires  DateTime?
  resetCodeHash        String?
  resetExpires         DateTime?

  // Onboarding de empresa (painel admin): o responsável do cadastro vira ADMIN
  // ligado à Company. companyRole é a função declarada no form
  // (owner/partner/manager/safety) — distinta do enum Role de autorização.
  // Nullable: seed/workers e o admin de seed não têm empresa.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  companyRole String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  exams         Exam[]
  reports       Report[]
  comments      Comment[]
  journeys      Journey[]
  messages      Message[]
  notifications Notification[]

  authoredWorkOrders WorkOrder[] @relation("authoredWorkOrders")
  responsibleFor     WorkOrder[] @relation("workOrderResponsibles")
  position           WorkerPosition?
  startedEvacuations Evacuation[]    @relation("startedEvacuations")
  evacuationAcks     EvacuationAck[]

  telemetryDevices     TelemetryDevice[]
  telemetryEnrollments TelemetryEnrollment[] @relation("enrolledWorker")
  createdEnrollments   TelemetryEnrollment[] @relation("enrollmentAuthor")
  telemetrySessions    TelemetrySession[]
  telemetrySamples     TelemetrySample[]
  telemetrySnapshot    TelemetrySnapshot?
  telemetryAssessments TelemetryAssessment[]
  telemetryConditions  TelemetryCondition[]
  telemetrySummaries   TelemetryDailySummary[]
  operationalAlerts    OperationalAlert[]    @relation("alertedWorker")
  triagedAlerts        OperationalAlert[]    @relation("triagedAlerts")
}

// Última posição conhecida de cada worker. SÓ a última: upsert por worker, sem
// trilha, por decisão do piloto.
// Fonte em produção: GPS do app mobile via POST /positions/heartbeat; em dev,
// o PositionSimulatorService (env SIM_POSITIONS=1) alimenta o MESMO caminho.
model WorkerPosition {
  id         String   @id @default(uuid())
  workerId   String   @unique
  worker     User     @relation(fields: [workerId], references: [id])
  lat        Float
  lng        Float
  // 'real' = GPS do app no celular; 'sim' = simulador dev. O simulador PULA
  // quem tem heartbeat real recente, ou seja, o celular assume o pino. O
  // default é 'sim' porque as linhas anteriores à coluna vieram todas dele.
  source     String   @default("sim")
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Empresa cadastrada no onboarding do painel (SignUp.tsx). Um cadastro cria a
// Company + o responsável como ADMIN (members[0]). Endereço mora aqui (não no
// Profile do admin) porque é da empresa, não da pessoa.
model Company {
  id           String   @id @default(uuid())
  name         String
  cnpj         String
  site         String?
  cep          String
  street       String
  number       String
  neighborhood String
  uf           String
  members      User[]
  evacuations  Evacuation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Domínios não-saúde (fundação), modelados em SQL relacional: identidade é o
// User local, referenciado por FK, e não um identificador de provedor externo.
// Não existe model Contact: o diretório de contatos é query sobre Users, com
// os campos de exibição (sector/jobTitle/avatarKey) no Profile.
// ---------------------------------------------------------------------------

// Enums em lowercase de propósito: paridade de wire com os types do seam
// mobile (sem @map).
enum ReportStatus {
  accept
  pending
  canceled
  info
}

enum JourneyState {
  idle
  ongoing
  paused
}

enum TaskStatus {
  pending
  in_progress
  paused
  done
}

enum WorkOrderStatus {
  pending
  in_progress
  done
}

enum NotificationDomain {
  weather
  chat
  reports
  journey
  faq
  evacuation
}

// ---------------------------------------------------------------------------
// Evacuação real. O admin dispara, os workers
// da org são notificados (fila) e confirmam presença no ponto de encontro
// (ack idempotente); o progresso X/N flui ao vivo por WS. Uma ativa por org.
// ---------------------------------------------------------------------------

enum EvacuationStatus {
  ACTIVE
  ENDED
}

model Evacuation {
  id          String           @id @default(uuid())
  // Nullable = bucket legado (null casa só com null), como User.companyId.
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  startedById String
  startedBy   User             @relation("startedEvacuations", fields: [startedById], references: [id])
  status      EvacuationStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  endedAt     DateTime?
  acks        EvacuationAck[]
}

model EvacuationAck {
  id           String     @id @default(uuid())
  evacuationId String
  evacuation   Evacuation @relation(fields: [evacuationId], references: [id])
  workerId     String
  worker       User       @relation(fields: [workerId], references: [id])
  ackAt        DateTime   @default(now())

  // Ack é idempotente: 1 confirmação por worker por evacuação.
  @@unique([evacuationId, workerId])
}

// Exame clínico enviado pelo worker. O card do design (ExamInfoCard) exige ano,
// dia/mês e NOME — só a chave do arquivo (o antigo Profile.examKeys, que nunca
// chegou a ser preenchido) não desenha nada. E as datas do Figma são futuras
// (2027, 2029…): é VALIDADE, não data de upload — por isso quem informa é o
// worker, nos campos ao lado do botão de envio.
model Exam {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  // Validade/vencimento. @db.Date porque é data de calendário: guardar hora
  // faria o dia virar em fusos negativos (mesma pegadinha do birthDate).
  date      DateTime @db.Date
  // Key emitida pelo presign no namespace exams/ — a URL assinada é derivada na
  // leitura, nunca persistida (expira).
  fileKey   String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Profile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  fullName     String?
  phone        String?
  cpf          String?
  birthDate    DateTime? @db.Date
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  uf           String?
  // Campos de exibição herdados do Contact morto — fonte canônica dos
  // snapshots denorm de Report/Conversation e do diretório de contatos do chat.
  sector       String?
  jobTitle     String? // cargo de exibição ("Operador de escavadeira") — distinto do enum Role
  avatarKey    String?
  // Colunas dos "Dados de saúde" do cadastro de funcionário e do settings. Sem
  // elas o que a pessoa preenche é descartado. Todos opcionais: são dados
  // declaratórios de cadastro, não telemetria (a telemetria segue mock
  // até a smartband).
  gender            String?
  bloodType         String?
  duty              String? // "Função" do settings (Operação/Manutenção/Supervisão) — distinto de jobTitle (cargo)
  allergies         String?
  chronicConditions String?
  managerName       String?
  // Coletados no wizard de onboarding do app (complimentary-data step 3), e
  // sem estas colunas a tela não teria onde gravar. São dados DIGITÁVEIS:
  // nada aqui depende da smartband, então são reais, nunca mock
  // (a fronteira é: digitável = real ou vazio; biometria = simulada por hash).
  heightCm          Int?
  weightKg          Int?
  hasDisability     Boolean?
  // Exames clínicos enviados (keys do bucket, prefixo exams/) — par do
  // "Histórico de exames" que renderizava vazio.
  examKeys     String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Destino do modal "Solicitação de suporte" (login e settings). Sem esta
// tabela o pedido é descartado em silêncio. userId e email são opcionais: no
// login não há sessão, então o form pede contato; logado, o vínculo vem do JWT.
model SupportRequest {
  id        String   @id @default(uuid())
  userId    String?
  email     String?
  reason    String
  title     String
  message   String
  createdAt DateTime @default(now())
}

model Report {
  id              String       @id @default(uuid())
  authorId        String
  author          User         @relation(fields: [authorId], references: [id])
  title           String
  summary         String?
  status          ReportStatus @default(pending)
  statusLabel     String?
  authorName      String? // snapshot denorm — card do inbox sem join (paridade com o mock)
  authorAvatarKey String?
  creationDate    DateTime     @default(now()) // data que a tela exibe, distinta do createdAt de sistema
  sector          String?
  responsibles    String[]
  details         String?
  imageKeys       String[]
  activities      Json?
  comments        Comment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([reportId])
}

model Journey {
  id                 String       @id @default(uuid())
  workerId           String
  worker             User         @relation(fields: [workerId], references: [id])
  date               DateTime     @db.Date
  state              JourneyState @default(idle)
  activeTaskId       String? // ponteiro soft de propósito, sem FK: a consistência é responsabilidade da Jornada
  startedAt          DateTime?
  accumulatedSeconds Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([workerId, date]) // turno por worker/dia
}

// Pai criado pelo admin: dona da atribuição (N responsáveis), dos anexos e do
// status derivado dos itens (3 tabs do admin). Os itens do checklist SÃO as
// Tasks que o worker já vê na jornada.
model WorkOrder {
  id               String          @id @default(uuid())
  authorId         String
  author           User            @relation("authoredWorkOrders", fields: [authorId], references: [id])
  title            String
  summary          String?
  details          String?
  sector           String?
  estimatedMinutes Int?
  startDate        DateTime?       @db.Date
  dueDate          DateTime?       @db.Date
  status           WorkOrderStatus @default(pending)
  imageKeys        String[]
  responsibles     User[]          @relation("workOrderResponsibles")
  items            Task[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
}

// Item de checklist / card da jornada. Mantém a máquina de estado por tempo
// (status inclui `paused` — 3 layouts da jornada mobile dependem dele). A
// atribuição subiu pro WorkOrder pai (perdeu assignedTo/objective/etc.).
model Task {
  id                 String     @id @default(uuid())
  orderId            String
  order              WorkOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position           Int        @default(0)
  title              String
  description        String?
  estimatedMinutes   Int?
  status             TaskStatus @default(pending)
  startedAt          DateTime?
  accumulatedSeconds Int        @default(0)
  progressPct        Float?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([orderId, position])
}

model Conversation {
  id                    String    @id // determinístico: [a,b].sort().join('#') — contrato do client (fatia Chat)
  participants          String[] // 2 user ids
  participantNames      String[] // snapshots denorm paralelos (paridade com o mock; fatia Chat pode simplificar)
  participantSubtitles  String[]
  participantAvatarKeys String[]
  lastMessageBody       String?
  lastMessageAt         DateTime?
  unreadByJson          Json? // { [userId]: count } — unread por-viewer
  messages              Message[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Message não guarda lista própria de participantes: o servidor checa
// membership via conversation.participants. Duplicar a lista por mensagem
// seria desnormalização sem leitor.
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  imageKey       String?
  sentAt         DateTime
  createdAt      DateTime     @default(now())
  // Editar e excluir mensagem. Excluir deixa MARCA, por decisão do usuário,
  // então `deletedAt` é lápide: o `body` continua na linha, reversível e
  // auditável, e é a API que para de devolvê-lo.
  editedAt       DateTime?
  deletedAt      DateTime?

  @@index([conversationId, sentAt])
}

model Notification {
  id        String             @id @default(uuid())
  workerId  String
  worker    User               @relation(fields: [workerId], references: [id])
  title     String
  body      String?
  domain    NotificationDomain
  targetId  String?
  read      Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([workerId, createdAt])
}

// Dedup do gatilho clima→notif: registra os alertas já notificados (o cron
// veria o mesmo alerta a cada tick → sem isto = spam). Único estado da fatia
// Clima (o clima em si é passthrough, sem persistência).
model WeatherAlertSeen {
  alertId    String   @id
  notifiedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Telemetria do piloto Apple Watch (ADR-0003). O monitoramento é contínuo e
// independente da Jornada SWI: nenhuma tabela daqui tem chave estrangeira para
// Journey ou Task, e por isso a telemetria persiste com a jornada parada.
//
// Unidades canônicas, uma vez só: bpm, passos inteiros, mpm, kcal, percentual
// de bateria e mmHg inteiro. O vocabulário em código é
// src/telemetry/domain/telemetry.types.ts; os enums abaixo são o mesmo
// vocabulário do lado do banco.
// ---------------------------------------------------------------------------

/// REAL vem do relógio ou de aparelho externo; DEMO é demonstração explícita.
/// Nunca se misturam na mesma sessão, snapshot ou média.
enum TelemetryOrigin {
  REAL
  DEMO
}

enum TelemetryDeviceKind {
  APPLE_WATCH
  IPHONE
  EXTERNAL_CUFF
}

enum TelemetrySessionStatus {
  ACTIVE
  INTERRUPTED
  ENDED
}

enum TelemetryMeasurementSource {
  APPLE_WATCH
  EXTERNAL_CUFF
  MANUAL_HEALTHKIT
  MANUAL_SWI
  DERIVED
}

enum TelemetryConditionKind {
  HEART_RATE_HIGH
  HEART_RATE_LOW
  BLOOD_PRESSURE_REVIEW
  DEVICE_BATTERY_LOW
  DEVICE_SIGNAL_LOST
}

enum TelemetryConditionStatus {
  ACTIVE
  RECOVERED
}

enum OperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// Convite de pareamento criado pelo administrador. O código é curto para ser
/// ditado ao funcionário, então quem o protege não é o tamanho: é a janela de
/// poucos minutos, o uso único e o limite de taxa da rota.
model TelemetryEnrollment {
  id          String              @id @default(uuid())
  workerId    String
  worker      User                @relation("enrolledWorker", fields: [workerId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User                @relation("enrollmentAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  kind        TelemetryDeviceKind

  /// Hash lento (bcrypt), como o código de confirmação de e-mail: seis dígitos
  /// têm entropia baixa e o custo do hash é parte da defesa.
  codeHash   String
  expiresAt  DateTime
  /// Carimbado na conclusão. É o que torna o código de uso único.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([workerId, consumedAt])
  @@index([expiresAt])
}

/// Aparelho pareado a um funcionário. O funcionário de cada evento sai daqui,
/// nunca do payload: por isso a credencial é o que liga dispositivo e pessoa.
model TelemetryDevice {
  id       String              @id @default(uuid())
  workerId String
  worker   User                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  kind     TelemetryDeviceKind
  model    String?
  /// Só o hash: o segredo em claro sai uma vez no pareamento e não volta.
  credentialHash String
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions TelemetrySession[]
  samples  TelemetrySample[]

  @@index([workerId, revokedAt])
}

/// Sessão técnica de monitoramento. O id é gerado no relógio e chega dentro do
/// evento como monitoringSessionId, então não tem @default: quem nomeia é o
/// aparelho, e é isso que torna o reenvio idempotente após reconexão.
model TelemetrySession {
  id       String                 @id
  deviceId String
  device   TelemetryDevice        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workerId String
  worker   User                   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  origin   TelemetryOrigin
  status   TelemetrySessionStatus @default(ACTIVE)

  startedAt     DateTime
  interruptedAt DateTime?
  endedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  samples     TelemetrySample[]
  snapshots   TelemetrySnapshot[]
  assessments TelemetryAssessment[]
  conditions  TelemetryCondition[]

  @@index([workerId, startedAt])
  @@index([origin, status])
}

/// Evento imutável, como o aparelho mediu. Nunca sofre update: correção vira
/// evento novo. É a trilha que permite auditar qualquer número apresentado.
model TelemetrySample {
  id String @id @default(uuid())
  /// Gerado no dispositivo. É a chave de idempotência do ACK de ingestão.
  eventId  String           @unique
  sessionId String
  session  TelemetrySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  deviceId String
  device   TelemetryDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Denormalizado do dispositivo: o histórico por funcionário é a consulta
  /// mais frequente e não deve depender de dois joins.
  workerId String
  worker   User             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  origin   TelemetryOrigin

  /// Sequência contínua dentro da sessão. Junto do eventId, é o que detecta
  /// lacuna de fila e reenvio embaralhado.
  sequence   Int
  /// Quando o aparelho mediu.
  eventTime  DateTime
  /// Quando o backend recebeu. A diferença entre os dois é o atraso da fila.
  receivedAt DateTime

  /// Contexto opcional, de propósito sem chave estrangeira: jornada e tarefa
  /// não controlam o monitoramento e não podem impedir a telemetria de gravar.
  journeyId String?
  taskId    String?

  heartRateBpm        Float?
  stepDelta           Int?
  activeEnergyKcal    Float?
  motionCount         Float?
  batteryPercent      Float?
  systolicMmHg        Int?
  diastolicMmHg       Int?
  /// Única fonte guardada em coluna: pressão é a métrica com várias origens
  /// possíveis, e o painel precisa saber se veio de aparelho ou digitação.
  bloodPressureSource TelemetryMeasurementSource?

  /// Payload normalizado como recebido, para auditoria.
  payload     Json
  /// sha256 do payload canônico. É o que separa repetição idêntica (sucesso
  /// idempotente) de mesmo identificador com conteúdo diferente (conflito).
  payloadHash String

  createdAt DateTime @default(now())

  @@unique([sessionId, sequence])
  @@index([workerId, eventTime])
  @@index([sessionId, eventTime])
  @@index([receivedAt])
}

/// Último estado promovido por funcionário. Só evento ao vivo chega aqui:
/// backlog vai para o histórico sem mexer no atual. Ausência é null, nunca
/// zero, e cada métrica guarda o próprio horário porque elas chegam em
/// eventos diferentes.
model TelemetrySnapshot {
  id        String            @id @default(uuid())
  workerId  String            @unique
  worker    User              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  sessionId String?
  session   TelemetrySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  origin    TelemetryOrigin

  lastEventId   String?
  lastEventTime DateTime

  heartRateBpm        Float?
  heartRateAt         DateTime?
  stepsTotal          Int?
  stepsAt             DateTime?
  activeEnergyKcal    Float?
  activeEnergyAt      DateTime?
  movementPerMinute   Float?
  movementAt          DateTime?
  batteryPercent      Float?
  batteryAt           DateTime?
  systolicMmHg        Int?
  diastolicMmHg       Int?
  bloodPressureSource TelemetryMeasurementSource?
  bloodPressureAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([origin, lastEventTime])
  @@index([sessionId])
}

/// Esforço e desgaste calculados. Guarda a versão da fórmula e as entradas
/// usadas: sem isso um número experimental vira um número sem defesa.
model TelemetryAssessment {
  id        String           @id @default(uuid())
  workerId  String
  worker    User             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  sessionId String
  session   TelemetrySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  origin    TelemetryOrigin

  computedAt  DateTime
  windowStart DateTime
  windowEnd   DateTime

  effortPercent Float?
  wearPercent   Float?

  /// Perfil versionado da fórmula. Experimental até a calibração em hardware.
  formulaVersion String
  /// Entradas do cálculo, para reproduzir o número exibido.
  inputs         Json

  createdAt DateTime @default(now())

  @@index([workerId, computedAt])
  @@index([sessionId, computedAt])
}

/// Condição automática detectada pelos limites do perfil. Duração é medida por
/// timestamps, nunca por quantidade de amostras, porque a fila do relógio varia
/// e contagem de amostras confundiria intervalo curto com intervalo longo.
model TelemetryCondition {
  id        String                   @id @default(uuid())
  workerId  String
  worker    User                     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  sessionId String?
  session   TelemetrySession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  origin    TelemetryOrigin
  kind      TelemetryConditionKind
  status    TelemetryConditionStatus @default(ACTIVE)

  firstSeenAt DateTime
  lastSeenAt  DateTime
  /// Preenchido pela banda de histerese, não pela primeira leitura normal.
  recoveredAt DateTime?

  /// Perfil de limites versionado que abriu a condição.
  thresholdProfile String
  observedValue    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alert OperationalAlert?

  @@index([workerId, status])
  @@index([status, lastSeenAt])
  @@index([sessionId])
}

/// Triagem humana da condição. É estado separado de propósito: a condição é o
/// que o sensor viu, o alerta é o que a operação decidiu fazer com aquilo.
/// Nenhum estado daqui bloqueia o funcionário automaticamente.
model OperationalAlert {
  id          String             @id @default(uuid())
  conditionId String             @unique
  condition   TelemetryCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User               @relation("alertedWorker", fields: [workerId], references: [id], onDelete: Cascade)

  status OperationalAlertStatus @default(OPEN)

  triagedById String?
  triagedBy   User?   @relation("triagedAlerts", fields: [triagedById], references: [id], onDelete: SetNull)

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([workerId, status])
}

/// Resumo do dia monitorado: uma linha por funcionário, dia e origem.
///
/// É o que permite apagar a Leitura bruta sem perder a história do piloto. O
/// dia é data de calendário, sem hora nem fuso, para que a chave não dependa de
/// conversão: quem traduz instante em dia é o domínio da telemetria, uma vez.
///
/// Toda estatística é anulável porque métrica ausente é desconhecida, nunca
/// zero. A exceção é a contagem de leituras, que existe sempre: a linha só é
/// gravada quando houve o que resumir.
model TelemetryDailySummary {
  id       String          @id @default(uuid())
  workerId String
  worker   User            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  /// Dia civil em Brasília, como data pura.
  day      DateTime        @db.Date
  origin   TelemetryOrigin

  heartRateMin   Float?
  heartRateMax   Float?
  heartRateAvg   Float?
  heartRateCount Int?
  /// Soma dos intervalos entre leituras consecutivas de BPM, sem as lacunas.
  heartRateCoveredMs Int?

  stepsTotal Int?
  stepsCount Int?

  activeEnergyKcalTotal Float?
  activeEnergyCount     Int?

  effortMax       Float?
  effortAvg       Float?
  effortCount     Int?
  effortAbove80Ms Int?
  wearMax         Float?
  wearAvg         Float?
  wearCount       Int?
  wearAbove80Ms   Int?

  bloodPressureCount      Int?
  lastSystolicMmHg        Int?
  lastDiastolicMmHg       Int?
  lastBloodPressureSource TelemetryMeasurementSource?
  lastBloodPressureAt     DateTime?

  batteryMin Float?

  /// Cobertura do dia: quantas leituras, quantas sessões tocaram o dia, a
  /// primeira e a última, e quanto tempo elas de fato cobrem.
  sampleCount   Int
  sessionCount  Int?
  firstSampleAt DateTime?
  lastSampleAt  DateTime?
  coveredMs     Int?

  /// Rastro do cálculo, para que um recálculo seja auditável.
  summarizerVersion String
  computedAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, day, origin])
  @@index([day])
}
