generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role           @default(WORKER)
  emailVerified  Boolean        @default(false)
  approvalStatus ApprovalStatus @default(PENDING)
  active         Boolean        @default(true)

  confirmationCodeHash String?
  confirmationExpires  DateTime?
  resetCodeHash        String?
  resetExpires         DateTime?

  // Onboarding de empresa (painel admin): o responsável do cadastro vira ADMIN
  // ligado à Company. companyRole é a função declarada no form
  // (owner/partner/manager/safety) — distinta do enum Role de autorização.
  // Nullable: seed/workers e o admin de seed não têm empresa.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  companyRole String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  reports       Report[]
  journeys      Journey[]
  messages      Message[]
  notifications Notification[]

  authoredWorkOrders WorkOrder[] @relation("authoredWorkOrders")
  responsibleFor     WorkOrder[] @relation("workOrderResponsibles")
}

// Empresa cadastrada no onboarding do painel (SignUp.tsx). Um cadastro cria a
// Company + o responsável como ADMIN (members[0]). Endereço mora aqui (não no
// Profile do admin) porque é da empresa, não da pessoa.
model Company {
  id           String   @id @default(uuid())
  name         String
  cnpj         String
  site         String?
  cep          String
  street       String
  number       String
  neighborhood String
  uf           String
  members      User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Domínios não-saúde (fundação) — shape-fonte: amplify/data/resource.ts,
// adaptado a SQL relacional (FKs para User no lugar de Cognito subs).
// O model Contact do Amplify morre: o diretório de contatos vira query sobre
// Users, com os campos de exibição (sector/jobTitle/avatarKey) no Profile.
// ---------------------------------------------------------------------------

// Enums em lowercase de propósito: paridade de wire com os types do seam
// mobile (sem @map).
enum ReportStatus {
  accept
  pending
  canceled
  info
}

enum JourneyState {
  idle
  ongoing
  paused
}

enum TaskStatus {
  pending
  in_progress
  paused
  done
}

enum WorkOrderStatus {
  pending
  in_progress
  done
}

enum NotificationDomain {
  weather
  chat
  reports
  journey
  faq
}

model Profile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  fullName     String?
  phone        String?
  cpf          String?
  birthDate    DateTime? @db.Date
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  uf           String?
  // Campos de exibição herdados do Contact morto — fonte canônica dos
  // snapshots denorm de Report/Conversation e do diretório de contatos do chat.
  sector       String?
  jobTitle     String? // cargo de exibição ("Operador de escavadeira") — distinto do enum Role
  avatarKey    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Report {
  id              String       @id @default(uuid())
  authorId        String
  author          User         @relation(fields: [authorId], references: [id])
  title           String
  summary         String?
  status          ReportStatus @default(pending)
  statusLabel     String?
  authorName      String? // snapshot denorm — card do inbox sem join (paridade com o mock)
  authorAvatarKey String?
  creationDate    DateTime     @default(now()) // paridade Amplify — campo de display, distinto do createdAt de sistema
  sector          String?
  responsibles    String[]
  details         String?
  imageKeys       String[]
  activities      Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Journey {
  id                 String       @id @default(uuid())
  workerId           String
  worker             User         @relation(fields: [workerId], references: [id])
  date               DateTime     @db.Date
  state              JourneyState @default(idle)
  activeTaskId       String? // ponteiro soft de propósito (paridade Amplify; sem FK — a fatia Jornada gerencia a consistência)
  startedAt          DateTime?
  accumulatedSeconds Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([workerId, date]) // turno por worker/dia
}

// Pai criado pelo admin: dona da atribuição (N responsáveis), dos anexos e do
// status derivado dos itens (3 tabs do admin). Os itens do checklist SÃO as
// Tasks que o worker já vê na jornada.
model WorkOrder {
  id               String          @id @default(uuid())
  authorId         String
  author           User            @relation("authoredWorkOrders", fields: [authorId], references: [id])
  title            String
  summary          String?
  details          String?
  sector           String?
  estimatedMinutes Int?
  startDate        DateTime?       @db.Date
  dueDate          DateTime?       @db.Date
  status           WorkOrderStatus @default(pending)
  imageKeys        String[]
  responsibles     User[]          @relation("workOrderResponsibles")
  items            Task[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
}

// Item de checklist / card da jornada. Mantém a máquina de estado por tempo
// (status inclui `paused` — 3 layouts da jornada mobile dependem dele). A
// atribuição subiu pro WorkOrder pai (perdeu assignedTo/objective/etc.).
model Task {
  id                 String     @id @default(uuid())
  orderId            String
  order              WorkOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position           Int        @default(0)
  title              String
  description        String?
  estimatedMinutes   Int?
  status             TaskStatus @default(pending)
  startedAt          DateTime?
  accumulatedSeconds Int        @default(0)
  progressPct        Float?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([orderId, position])
}

model Conversation {
  id                    String    @id // determinístico: [a,b].sort().join('#') — contrato do client (fatia Chat)
  participants          String[] // 2 user ids
  participantNames      String[] // snapshots denorm paralelos (paridade com o mock; fatia Chat pode simplificar)
  participantSubtitles  String[]
  participantAvatarKeys String[]
  lastMessageBody       String?
  lastMessageAt         DateTime?
  unreadByJson          Json? // { [userId]: count } — unread por-viewer
  messages              Message[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Message.participants do Amplify morre — num DB relacional o servidor checa
// membership via conversation.participants (era denorm exigida pelo
// ownersDefinedIn do AppSync).
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  imageKey       String?
  sentAt         DateTime
  createdAt      DateTime     @default(now())

  @@index([conversationId, sentAt])
}

model Notification {
  id        String             @id @default(uuid())
  workerId  String
  worker    User               @relation(fields: [workerId], references: [id])
  title     String
  body      String?
  domain    NotificationDomain
  targetId  String?
  read      Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([workerId, createdAt])
}

// Dedup do gatilho clima→notif: registra os alertas já notificados (o cron
// veria o mesmo alerta a cada tick → sem isto = spam). Único estado da fatia
// Clima (o clima em si é passthrough, sem persistência).
model WeatherAlertSeen {
  alertId    String   @id
  notifiedAt DateTime @default(now())
}
