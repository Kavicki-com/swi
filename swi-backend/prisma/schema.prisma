generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role           @default(WORKER)
  emailVerified  Boolean        @default(false)
  approvalStatus ApprovalStatus @default(PENDING)
  active         Boolean        @default(true)

  confirmationCodeHash String?
  confirmationExpires  DateTime?
  resetCodeHash        String?
  resetExpires         DateTime?

  // Onboarding de empresa (painel admin): o responsável do cadastro vira ADMIN
  // ligado à Company. companyRole é a função declarada no form
  // (owner/partner/manager/safety) — distinta do enum Role de autorização.
  // Nullable: seed/workers e o admin de seed não têm empresa.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  companyRole String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  exams         Exam[]
  reports       Report[]
  comments      Comment[]
  journeys      Journey[]
  messages      Message[]
  notifications Notification[]

  authoredWorkOrders WorkOrder[] @relation("authoredWorkOrders")
  responsibleFor     WorkOrder[] @relation("workOrderResponsibles")
  position           WorkerPosition?
  startedEvacuations Evacuation[]    @relation("startedEvacuations")
  evacuationAcks     EvacuationAck[]
}

// Última posição conhecida de cada worker (Fase 1 do realtime de localização,
// 2026-07-24). SÓ a última — upsert por worker, sem trilha (decisão do piloto).
// Fonte em produção: GPS do app mobile via POST /positions/heartbeat; em dev,
// o PositionSimulatorService (env SIM_POSITIONS=1) alimenta o MESMO caminho.
model WorkerPosition {
  id         String   @id @default(uuid())
  workerId   String   @unique
  worker     User     @relation(fields: [workerId], references: [id])
  lat        Float
  lng        Float
  // 'real' = GPS do app no celular; 'sim' = simulador dev. O simulador PULA
  // quem tem heartbeat real recente (o celular assume o pino — decisão
  // 2026-07-26); default 'sim' porque toda linha pré-existente era dele.
  source     String   @default("sim")
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Empresa cadastrada no onboarding do painel (SignUp.tsx). Um cadastro cria a
// Company + o responsável como ADMIN (members[0]). Endereço mora aqui (não no
// Profile do admin) porque é da empresa, não da pessoa.
model Company {
  id           String   @id @default(uuid())
  name         String
  cnpj         String
  site         String?
  cep          String
  street       String
  number       String
  neighborhood String
  uf           String
  members      User[]
  evacuations  Evacuation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Domínios não-saúde (fundação) — shape-fonte: amplify/data/resource.ts,
// adaptado a SQL relacional (FKs para User no lugar de Cognito subs).
// O model Contact do Amplify morre: o diretório de contatos vira query sobre
// Users, com os campos de exibição (sector/jobTitle/avatarKey) no Profile.
// ---------------------------------------------------------------------------

// Enums em lowercase de propósito: paridade de wire com os types do seam
// mobile (sem @map).
enum ReportStatus {
  accept
  pending
  canceled
  info
}

enum JourneyState {
  idle
  ongoing
  paused
}

enum TaskStatus {
  pending
  in_progress
  paused
  done
}

enum WorkOrderStatus {
  pending
  in_progress
  done
}

enum NotificationDomain {
  weather
  chat
  reports
  journey
  faq
  evacuation
}

// ---------------------------------------------------------------------------
// Evacuação real (Fase 2 do realtime, 2026-07-25). O admin dispara, os workers
// da org são notificados (fila) e confirmam presença no ponto de encontro
// (ack idempotente); o progresso X/N flui ao vivo por WS. Uma ativa por org.
// ---------------------------------------------------------------------------

enum EvacuationStatus {
  ACTIVE
  ENDED
}

model Evacuation {
  id          String           @id @default(uuid())
  // Nullable = bucket legado (null casa só com null), como User.companyId.
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id])
  startedById String
  startedBy   User             @relation("startedEvacuations", fields: [startedById], references: [id])
  status      EvacuationStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  endedAt     DateTime?
  acks        EvacuationAck[]
}

model EvacuationAck {
  id           String     @id @default(uuid())
  evacuationId String
  evacuation   Evacuation @relation(fields: [evacuationId], references: [id])
  workerId     String
  worker       User       @relation(fields: [workerId], references: [id])
  ackAt        DateTime   @default(now())

  // Ack é idempotente: 1 confirmação por worker por evacuação.
  @@unique([evacuationId, workerId])
}

// Exame clínico enviado pelo worker. O card do design (ExamInfoCard) exige ano,
// dia/mês e NOME — só a chave do arquivo (o antigo Profile.examKeys, que nunca
// chegou a ser preenchido) não desenha nada. E as datas do Figma são futuras
// (2027, 2029…): é VALIDADE, não data de upload — por isso quem informa é o
// worker, nos campos ao lado do botão de envio.
model Exam {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  // Validade/vencimento. @db.Date porque é data de calendário: guardar hora
  // faria o dia virar em fusos negativos (mesma pegadinha do birthDate).
  date      DateTime @db.Date
  // Key emitida pelo presign no namespace exams/ — a URL assinada é derivada na
  // leitura, nunca persistida (expira).
  fileKey   String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Profile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  fullName     String?
  phone        String?
  cpf          String?
  birthDate    DateTime? @db.Date
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  uf           String?
  // Campos de exibição herdados do Contact morto — fonte canônica dos
  // snapshots denorm de Report/Conversation e do diretório de contatos do chat.
  sector       String?
  jobTitle     String? // cargo de exibição ("Operador de escavadeira") — distinto do enum Role
  avatarKey    String?
  // QA F (2026-07-24): os "Dados de saúde" do cadastro de funcionário e do
  // settings eram coletados e DESCARTADOS (sem coluna). Todos opcionais —
  // dados declaratórios de cadastro, não telemetria (a telemetria segue mock
  // até a smartband).
  gender            String?
  bloodType         String?
  duty              String? // "Função" do settings (Operação/Manutenção/Supervisão) — distinto de jobTitle (cargo)
  allergies         String?
  chronicConditions String?
  managerName       String?
  // Coletados no wizard de onboarding do app (complimentary-data step 3) e
  // DESCARTADOS até 2026-07-26: a tela não tinha coluna pra gravar. São dados
  // DIGITÁVEIS — nada aqui depende da smartband, então são reais, nunca mock
  // (a fronteira é: digitável = real ou vazio; biometria = simulada por hash).
  heightCm          Int?
  weightKg          Int?
  hasDisability     Boolean?
  // Exames clínicos enviados (keys do bucket, prefixo exams/) — par do
  // "Histórico de exames" que renderizava vazio.
  examKeys     String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// QA F (2026-07-24): o modal "Solicitação de suporte" (login e settings)
// descartava o pedido em silêncio. userId/email opcionais: no login não há
// sessão, então o form pede contato; logado, o vínculo vem do JWT.
model SupportRequest {
  id        String   @id @default(uuid())
  userId    String?
  email     String?
  reason    String
  title     String
  message   String
  createdAt DateTime @default(now())
}

model Report {
  id              String       @id @default(uuid())
  authorId        String
  author          User         @relation(fields: [authorId], references: [id])
  title           String
  summary         String?
  status          ReportStatus @default(pending)
  statusLabel     String?
  authorName      String? // snapshot denorm — card do inbox sem join (paridade com o mock)
  authorAvatarKey String?
  creationDate    DateTime     @default(now()) // paridade Amplify — campo de display, distinto do createdAt de sistema
  sector          String?
  responsibles    String[]
  details         String?
  imageKeys       String[]
  activities      Json?
  comments        Comment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([reportId])
}

model Journey {
  id                 String       @id @default(uuid())
  workerId           String
  worker             User         @relation(fields: [workerId], references: [id])
  date               DateTime     @db.Date
  state              JourneyState @default(idle)
  activeTaskId       String? // ponteiro soft de propósito (paridade Amplify; sem FK — a fatia Jornada gerencia a consistência)
  startedAt          DateTime?
  accumulatedSeconds Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([workerId, date]) // turno por worker/dia
}

// Pai criado pelo admin: dona da atribuição (N responsáveis), dos anexos e do
// status derivado dos itens (3 tabs do admin). Os itens do checklist SÃO as
// Tasks que o worker já vê na jornada.
model WorkOrder {
  id               String          @id @default(uuid())
  authorId         String
  author           User            @relation("authoredWorkOrders", fields: [authorId], references: [id])
  title            String
  summary          String?
  details          String?
  sector           String?
  estimatedMinutes Int?
  startDate        DateTime?       @db.Date
  dueDate          DateTime?       @db.Date
  status           WorkOrderStatus @default(pending)
  imageKeys        String[]
  responsibles     User[]          @relation("workOrderResponsibles")
  items            Task[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
}

// Item de checklist / card da jornada. Mantém a máquina de estado por tempo
// (status inclui `paused` — 3 layouts da jornada mobile dependem dele). A
// atribuição subiu pro WorkOrder pai (perdeu assignedTo/objective/etc.).
model Task {
  id                 String     @id @default(uuid())
  orderId            String
  order              WorkOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position           Int        @default(0)
  title              String
  description        String?
  estimatedMinutes   Int?
  status             TaskStatus @default(pending)
  startedAt          DateTime?
  accumulatedSeconds Int        @default(0)
  progressPct        Float?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([orderId, position])
}

model Conversation {
  id                    String    @id // determinístico: [a,b].sort().join('#') — contrato do client (fatia Chat)
  participants          String[] // 2 user ids
  participantNames      String[] // snapshots denorm paralelos (paridade com o mock; fatia Chat pode simplificar)
  participantSubtitles  String[]
  participantAvatarKeys String[]
  lastMessageBody       String?
  lastMessageAt         DateTime?
  unreadByJson          Json? // { [userId]: count } — unread por-viewer
  messages              Message[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Message.participants do Amplify morre — num DB relacional o servidor checa
// membership via conversation.participants (era denorm exigida pelo
// ownersDefinedIn do AppSync).
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  imageKey       String?
  sentAt         DateTime
  createdAt      DateTime     @default(now())

  @@index([conversationId, sentAt])
}

model Notification {
  id        String             @id @default(uuid())
  workerId  String
  worker    User               @relation(fields: [workerId], references: [id])
  title     String
  body      String?
  domain    NotificationDomain
  targetId  String?
  read      Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([workerId, createdAt])
}

// Dedup do gatilho clima→notif: registra os alertas já notificados (o cron
// veria o mesmo alerta a cada tick → sem isto = spam). Único estado da fatia
// Clima (o clima em si é passthrough, sem persistência).
model WeatherAlertSeen {
  alertId    String   @id
  notifiedAt DateTime @default(now())
}
