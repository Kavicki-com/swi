# Contrato de ambiente do backend. A lista é validada no boot por
# src/config/runtime-env.ts: em produção, variável obrigatória ausente ou valor
# inseguro derruba a inicialização em vez de falhar na primeira requisição.
#
# Todos os valores abaixo são placeholders locais. Nenhum segredo real entra
# neste arquivo; o .env de verdade é ignorado pelo git.

# development | test | production. Qualquer outro valor é recusado no boot.
NODE_ENV="development"

# Banco. Obrigatória em produção.
DATABASE_URL="postgresql://swi:swi@localhost:5432/swi"

# Assinatura dos tokens. Obrigatória em produção e com no mínimo 32 caracteres.
# Gere com: openssl rand -hex 32
JWT_SECRET="troque-por-um-segredo-forte-openssl-rand-hex-32"

# Porta HTTP. Ignorada quando LISTEN_SOCKET está definida.
PORT="3000"

# Socket Unix da hospedagem que faz proxy por socket em vez de porta TCP.
# Deixe vazio no Docker local e nos testes.
LISTEN_SOCKET=""

# Origins liberadas no CORS HTTP (CSV). É daqui que o painel swi-admin bate.
# Default = dev server do Vite. Em produção precisa listar domínios https
# reais: curinga e endereço local são recusados no boot.
CORS_ORIGINS="http://localhost:5173"

# URL do painel usada nos links de e-mail (recuperação de senha).
ADMIN_APP_URL="http://localhost:5173"

# Vale 1 quando o proxy do host já injeta Access-Control-Allow-Origin. Nesse
# modo a API não emite o header para não duplicá-lo.
CORS_PROXY_SETS_ORIGIN=""

# Vale 1 quando esse proxy carimba o header TAMBÉM nas respostas de erro.
# Vazio (o caso da hospedagem atual, cujo add_header não tem `always`) faz a
# API preencher o header nos status que o proxy deixa de fora, senão nenhum
# erro chega legível no painel: o navegador rejeita o fetch e a mensagem do
# backend se perde. Só tem efeito com CORS_PROXY_SETS_ORIGIN=1.
CORS_PROXY_SETS_ORIGIN_ON_ERRORS=""

# E-mail. Default local = MailHog. Dentro do Docker, o compose interpola as
# variantes API_SMTP_* do .env do host e as entrega ao container já com os
# nomes abaixo; o prefixo existe para que SMTP_HOST=localhost, que é verdade na
# perspectiva do host, não vaze para dentro do container.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Remetente. Obrigatório em produção.
MAIL_FROM="no-reply@swi.local"

# Destinatário das denúncias de mensagem do chat. Obrigatório em produção: sem
# ele a rota de denúncia responde 503 em vez de mandar denúncia para o vácuo.
# Dentro do Docker, defina API_REPORT_TO_EMAIL.
REPORT_TO_EMAIL="moderacao@swi.local"

# Mídia. MinIO local. MINIO_PUBLIC_URL é o host que as URLs presigned usam (a
# assinatura fica atada ao host). Em infraestrutura com credencial de instância,
# deixe as duas chaves unset: metade do par é recusada no boot.
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="swi-media"
MINIO_REGION="us-east-1"

# Roteamento de evacuação. Vazio usa o OSRM público (keyless). Em produção,
# token do provedor contratado.
MAPBOX_TOKEN=""

# Coleta de clima. Vazio cai no intervalo default do código.
WEATHER_CRON=""

# Somente desenvolvimento e demonstração: fabricam dados de tela.
# WEATHER_SCENARIO=alert força um alerta de tempestade.
# SIM_POSITIONS=1 movimenta os workers do seed pelo site.
# Nunca defina nenhuma das duas em produção.
WEATHER_SCENARIO=""
SIM_POSITIONS=""

# Ciclo de vida da telemetria. O job resume o dia fechado e só então apaga a
# Leitura bruta já resumida.
# TELEMETRY_LIFECYCLE_CRON: vazio roda 06:30 UTC, madrugada em Brasília.
# TELEMETRY_RETENTION_DAYS: vazio retém 30 dias. Piso de 2 dias (48 horas), que
# é o prazo em que um dia monitorado fecha; abaixo disso o processo não sobe.
# TELEMETRY_RETENTION_BATCH_SIZE: vazio apaga em lotes de 5000 linhas.
TELEMETRY_LIFECYCLE_CRON=""
TELEMETRY_RETENTION_DAYS=""
TELEMETRY_RETENTION_BATCH_SIZE=""
