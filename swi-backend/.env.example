DATABASE_URL="postgresql://swi:swi@localhost:5432/swi"
JWT_SECRET="troque-por-um-segredo-forte-openssl-rand-hex-32"
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="no-reply@swi.local"
PORT="3000"

# Origins liberadas no CORS HTTP (CSV) — é daqui que o painel swi-admin bate.
# Default = dev server do Vite. Em AWS liste os domínios reais do painel.
CORS_ORIGINS="http://localhost:5173"

# Mídia (Fatia 2) — MinIO local/QA. Em AWS deixe MINIO_* unset: o SDK usa a
# default credential chain (IAM role) + o endpoint real do S3.
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="swi-media"
MINIO_REGION="us-east-1"
